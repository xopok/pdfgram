# ==========================================
# Telegram Bot Configuration (Required)
# ==========================================
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Optional: Restrict bot access to specific Telegram user IDs (comma-separated).
# If left empty, anyone who discovers your bot can use it.
# You can find your user ID via @userinfobot or @raw_data_bot on Telegram.
ALLOWED_USER_IDS=

# ==========================================
# Margin Cropping Configuration
# ==========================================
# Percentage of margin space to retain (default: 10).
# 0 = tightest crop, 10 = keeps 10% breathing room for e-readers/Kindle.
CROP_PERCENT=10

# Crop all pages uniformly so text bounding doesn't jump around between pages (true/false)
CROP_UNIFORM=true

# Force all pages to the exact same dimension (true/false)
CROP_SAME_PAGE_SIZE=false

# Any extra command line flags to pass directly to pdfCropMargins (optional)
CROP_EXTRA_ARGS=

# Maximum allowed PDF download size in MB (Telegram document upload limit is 50MB)
MAX_FILE_SIZE_MB=50

# ==========================================
# Delivery Action
# ==========================================
# Action to perform when a link is sent:
# - 'ask': Show interactive inline buttons: [Send to Chat] [Send to Kindle] [Send Both]
# - 'chat': Always send the cropped document back directly to the Telegram chat
# - 'kindle': Send the cropped document to Kindle email
# - 'both': Send to both Telegram chat and Kindle email
# Default: 'ask' if Kindle/SMTP is configured, otherwise 'chat'.
DEFAULT_ACTION=ask

# ==========================================
# Send-to-Kindle Configuration (Optional)
# ==========================================
# Default recipient Kindle email address (can also be set per-user via /setkindle)
KINDLE_EMAIL=yourname@kindle.com

# SMTP settings used to email the document to Amazon Kindle
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your_email@gmail.com
#   SMTP_PASSWORD=your_gmail_app_password (generate via Google Account -> Security -> App Passwords)
#   SMTP_USE_TLS=true
#   SMTP_USE_SSL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=
