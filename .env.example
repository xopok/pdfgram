# ==========================================
# Telegram Bot Configuration (Required)
# ==========================================
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567

# Optional: Restrict bot access to specific Telegram user IDs (comma-separated).
# If left empty, anyone who discovers your bot can use it.
# You can find your user ID via @userinfobot or @raw_data_bot on Telegram.
ALLOWED_USER_IDS=

# ==========================================
# Margin Cropping Configuration
# ==========================================
# Percentage of margin space to retain (default: 10).
# 0 = tightest crop, 10 = keeps 10% breathing room.
CROP_PERCENT=10

# Crop all pages uniformly so text bounding doesn't jump around between pages (true/false)
CROP_UNIFORM=true

# Force all pages to the exact same dimension (true/false)
CROP_SAME_PAGE_SIZE=false

# Any extra command line flags to pass directly to pdfCropMargins (optional)
CROP_EXTRA_ARGS=

# Maximum allowed PDF download size in MB (Telegram document upload limit is 50MB)
MAX_FILE_SIZE_MB=50
